# MetaPilot Solana Environment Configuration

# Solana Network Configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Local Development (when running local validator)
# NEXT_PUBLIC_SOLANA_NETWORK=localnet
# NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899

# Program IDs (from Anchor.toml)
NEXT_PUBLIC_DAO_VOTING_PROGRAM_ID=CSxir1KkCbcKZpmUuEouTL4uLzwL4C7MTYyZrkxcKjv1
NEXT_PUBLIC_TOKEN_AUTOMATION_PROGRAM_ID=C7QmRHfSMg9YtcFyjGdfqA1PxBjZzefxxsBNggFTgcqR
NEXT_PUBLIC_YIELD_OPTIMIZER_PROGRAM_ID=uZWfyq9bwsiHUhLNXZKXEHkkbCpiin7Y3HvYNHDX4WQ
NEXT_PUBLIC_TRANSACTION_SCHEDULER_PROGRAM_ID=E4vpdUcGQd9bnzePzwJPKFNxrA5WARgFVzm77zfh2Hpe

# AI Engine Configuration
NEXT_PUBLIC_AI_ENGINE_ENABLED=true
NEXT_PUBLIC_AI_CONFIDENCE_THRESHOLD=70

# MetaPilot Features
NEXT_PUBLIC_ENABLE_DAO_VOTING=true
NEXT_PUBLIC_ENABLE_TOKEN_AUTOMATION=true
NEXT_PUBLIC_ENABLE_YIELD_OPTIMIZATION=true
NEXT_PUBLIC_ENABLE_TRANSACTION_SCHEDULING=true

# Development flags
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=true

# Wallet Configuration
NEXT_PUBLIC_PREFERRED_WALLET=phantom
NEXT_PUBLIC_ENABLE_MULTI_CHAIN=true
